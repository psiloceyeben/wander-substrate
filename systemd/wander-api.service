[Unit]
Description=Wander Around API (FastAPI on 127.0.0.1:8050)
After=network.target

[Service]
User=wander
Group=wander
WorkingDirectory=/opt/wander
Environment=PYTHONPATH=/opt/wander/src
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --host 127.0.0.1 --port 8050 --no-server-header --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
LimitNOFILE=4096

# ── Hardening ─────────────────────────────────────────────────────────
# Code lives at /opt/wander (FHS-conformant); /root not touched, so we
# can enable ProtectHome=true to block any accidental access to user
# home directories. Service runs as the dedicated unprivileged `wander`
# user; data is writable under /opt/wander/data and /opt/wander/logs.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/wander/data /opt/wander/logs
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
